docs/
*.jsonl
node_modules/
.DS_Store

# runtime data: the interviewee's own trajectory files and working
# annotations should not be committed to the shared repo. Keep the
# directories themselves (via .gitkeep) so the app has somewhere to read
# from and write to right after a fresh clone.
data/trajectories/*
!data/trajectories/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
