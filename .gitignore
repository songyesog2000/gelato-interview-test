docs/
*.jsonl
!samples/*.jsonl
node_modules/
.DS_Store

# per-candidate runtime data (their own trajectory files + annotation work)
# lives entirely under data/candidates/<code>/ once the server assigns it;
# none of it should be committed to the shared repo. Keep the directory
# itself (via .gitkeep) so the app has somewhere to write on a fresh clone.
data/candidates/*
!data/candidates/.gitkeep

# real candidate code -> name roster; only the example template is tracked
server/config/candidates.json
